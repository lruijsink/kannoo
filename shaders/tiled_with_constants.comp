#version 450

#define WORKGROUP_SIZE 32
layout (local_size_x = WORKGROUP_SIZE, local_size_y = WORKGROUP_SIZE) in;

layout(constant_id = 0) const uint INPUT_SIZE = 1;
layout(constant_id = 1) const uint OUTPUT_SIZE = 1;
layout(constant_id = 2) const uint BATCH_SIZE = 1;

// Input matrix I (N x K)
layout(binding = 0) readonly buffer InputBuffer {
    float I[];
};

// Weight matrix W (M x K)
layout(binding = 1) readonly buffer WeightBuffer {
    float W[];
};

// Output matrix O (N x M)
layout(binding = 2) writeonly buffer OutputBuffer {
    float O[];
};

shared float tileI[WORKGROUP_SIZE][WORKGROUP_SIZE];
shared float tileW[WORKGROUP_SIZE][WORKGROUP_SIZE];

void main() {
    uint row = gl_GlobalInvocationID.y;
    uint col = gl_GlobalInvocationID.x;

    float sum = 0.0;

    for (uint t = 0; t < INPUT_SIZE; t += WORKGROUP_SIZE) {
        uint lx = gl_LocalInvocationID.x;
        uint ly = gl_LocalInvocationID.y;

        tileI[ly][lx] = (t + lx < INPUT_SIZE) ? I[row * INPUT_SIZE + (t + lx)] : 0.0;
        tileW[ly][lx] = (t + ly < INPUT_SIZE) ? W[col * INPUT_SIZE + (t + ly)] : 0.0;

        barrier();

        for (uint k = 0; k < WORKGROUP_SIZE; k++) {
            sum += tileI[ly][k] * tileW[k][lx];
        }

        barrier();
    }

    if (row < BATCH_SIZE && col < OUTPUT_SIZE) {
        O[row * OUTPUT_SIZE + col] = sum;
    }
}
